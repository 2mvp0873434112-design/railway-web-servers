FROM php:8.2-apache

# 1. ติดตั้งไดรเวอร์เชื่อมต่อ MySQL
RUN docker-php-ext-install pdo pdo_mysql

# 2. ปรับพอร์ตเฉพาะบรรทัดที่เป็นตัวเลขพอร์ตอย่างปลอดภัย
RUN sed -i 's/<VirtualHost \*:80>/<VirtualHost \*:${PORT}>/' /etc/apache2/sites-available/000-default.conf \
    && sed -i 's/Listen 80/Listen ${PORT}/' /etc/apache2/ports.conf

# 3. คัดลอกไฟล์หน้าเว็บ
COPY index.php /var/www/html/

# 4. ตั้งสิทธิ์โฟลเดอร์
RUN chown -R www-data:www-data /var/www/html

ENV PORT=80
EXPOSE 80

CMD ["apache2-foreground"]
