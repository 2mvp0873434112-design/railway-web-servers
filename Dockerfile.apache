FROM php:8.2-apache

# ติดตั้ง Extension pdo และ pdo_mysql
RUN docker-php-ext-install pdo pdo_mysql

# ปิด MPM event/worker และเปิดใช้งาน mpm_prefork เพียงตัวเดียว
RUN a2dismod mpm_event mpm_worker || true \
    && a2enmod mpm_prefork rewrite

# คัดลอกโค้ดเว็บไปยัง DocumentRoot
COPY index.php /var/www/html/

# กำหนดสิทธิ์โฟลเดอร์ให้ www-data
RUN chown -R www-data:www-data /var/www/html

ENV PORT=80
EXPOSE 80

CMD ["apache2-foreground"]
